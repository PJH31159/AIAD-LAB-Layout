# 운영체제와 관계없이 텍스트 파일을 LF로 정규화합니다.
* text=auto eol=lf

# 소스와 프로젝트 설정은 항상 LF를 사용합니다.
*.css       text eol=lf
*.html      text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.jsx       text eol=lf
*.md        text eol=lf
*.mjs       text eol=lf
*.sh        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# Windows 명령 스크립트는 CRLF를 유지합니다.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 바이너리 파일은 줄바꿈 변환 대상에서 제외합니다.
*.gif       binary
*.ico       binary
*.jpeg      binary
*.jpg       binary
*.png       binary
*.webp      binary
*.woff      binary
*.woff2     binary
